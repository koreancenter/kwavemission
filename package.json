{
  "name": "kwavemission",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "echo 'No build required'",
    "lint": "node --check server.js",
    "start": "node server.js",
    "build:css": "tailwindcss -i ./assets/css/tailwind.input.css -o ./assets/css/tailwind.public.css --minify && tailwindcss -i ./assets/css/tailwind.admin.input.css -o ./assets/css/tailwind.admin.css --minify && tailwindcss -i ./assets/css/tailwind.official.input.css -o ./assets/css/tailwind.official.css --minify"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "compression": "^1.8.1",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "tailwindcss": "^4.3.3"
  }
}
