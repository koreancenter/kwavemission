{
  "routes": [
    {
      "routePath": "/api/image/:path*",
      "mountPath": "/api/image",
      "method": "GET",
      "module": [
        "api/image/[[path]].js:onRequestGet"
      ]
    },
    {
      "routePath": "/api/delete-post",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/delete-post.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/get-posts",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/get-posts.js:onRequestGet"
      ]
    },
    {
      "routePath": "/api/update-post",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/update-post.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/write-post",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/write-post.js:onRequestPost"
      ]
    }
  ],
  "baseURL": "/"
}